# Copy this file to .env and fill in your own values.
# Never commit your actual .env file — it contains secrets.

# NVIDIA NIM (LLM reasoning)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Mireye (physical-world site data)
MIREYE_TOKEN=your-mireye-bearer-token

# U.S. EIA (electricity pricing) — free key at https://www.eia.gov/opendata
EIA_API_KEY=your-eia-api-key

# Postgres (conversation state checkpointing)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
